# ==============================================================================
# ATENDIA — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================
# Toda la aplicación opera en idioma español (es-SV) y zona horaria America/El_Salvador (UTC-6).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL
# ------------------------------------------------------------------------------
# En desarrollo local: arranca automáticamente con PGlite en 127.0.0.1:5432 (sin Docker).
# El parámetro ?pgbouncer=true desactiva named prepared statements para máxima compatibilidad.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/atendia?pgbouncer=true"
PGPORT=5432
PGDATA_DIR="./data/pgdata"

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y CIFRADO CRIPTOGRÁFICO
# ------------------------------------------------------------------------------
# Clave maestra para cifrado simétrico AES-256-GCM (32 bytes = 64 caracteres hexadecimales).
# Cifra tokens OAuth de Google, API Key de YCloud, credenciales Stripe y URLs de Slack.
ENCRYPTION_KEY="6742eac845a5f7747cdb5cb9117df7bd25e0240f016a25ba38b5eba6d0c7e043"

# Secreto para la firma y verificación de tokens de sesión JWT de usuario (Auth.js / jose)
AUTH_SECRET="f40774fb662aa468e7d12a0194acee0d05eba6fffd94ba6879462b8f7e9732c0"

# Administrador inicial creado de forma automática durante la semilla inicial
ADMIN_EMAIL="admin@demo.daniautoma.cloud"
ADMIN_PASSWORD="admin1234password"

# ------------------------------------------------------------------------------
# 3. URL PÚBLICA DE LA APLICACIÓN
# ------------------------------------------------------------------------------
# URL base donde se hospeda la app (utilizada en cabeceras HTTP-Referer y redirecciones OAuth)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. INTELIGENCIA ARTIFICIAL (OPENROUTER)
# ------------------------------------------------------------------------------
# Clave de API de OpenRouter (https://openrouter.ai/keys).
# Las llamadas envían cabeceras HTTP-Referer ($APP_URL) y X-Title ("Coversa").
# Modelo por defecto: anthropic/claude-haiku-5.5 (con soporte de tools).
OPENROUTER_API_KEY=""

# ------------------------------------------------------------------------------
# 5. CANAL WHATSAPP: BAILEYS (CÓDIGO QR LOCAL)
# ------------------------------------------------------------------------------
# Directorio donde se almacena la sesión de WhatsApp para que sobreviva a reinicios.
WHATSAPP_SESSION_DIR="./whatsapp-session"

# ------------------------------------------------------------------------------
# 6. INTEGRACIONES DE GOOGLE (CALENDAR, GMAIL, GOOGLE SHEETS)
# ------------------------------------------------------------------------------
# Un único cliente OAuth en Google Cloud Console con autorización incremental.
# URI de redirección autorizada: $APP_URL/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 7. INTEGRACIONES OPCIONALES (CONFIGURABLES TAMBIÉN DESDE EL PANEL)
# ------------------------------------------------------------------------------
# Incoming Webhook de Slack para alertas de pase a humano y citas agendadas
SLACK_WEBHOOK_URL=""

# Clave restringida de Stripe (Restricted Key con permisos para Checkout Sessions)
STRIPE_RESTRICTED_KEY=""

# Alertas unidireccionales de Telegram para pase a humano (WAITING_HUMAN)
# Token obtenido mediante @BotFather en Telegram (ej: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=""
# ID numérico de chat del administrador para recibir las alertas (ej: 123456789 o -100xxxxxxxxxx para grupo)
TELEGRAM_ADMIN_CHAT_ID=""
